msgctxt "help:account.tax,isp:"
msgid "Indicates if the tax is Inversion del sujeto Pasivo"
msgstr "表示该税项是否适用反向征税。"

msgctxt "help:account.tax,service:"
msgid "Indicates if the tax is used for services"
msgstr "表示该税项是否用于服务。"

